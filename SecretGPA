/* =========================================================
   RENDER SUBJECTS
========================================================= */

function renderSubjects() {
  const container =
    document.getElementById("subjects");

  const search =
    document
      .getElementById("searchInput")
      .value
      .trim()
      .toLowerCase();

  const category =
    document
      .getElementById("categoryFilter")
      .value;

  const filtered = subjects.filter(subject => {

    const matchesSearch =
      subject.name
        .toLowerCase()
        .includes(search);

    const matchesCategory =
      category === "전체" ||
      subject.category === category;

    return matchesSearch && matchesCategory;
  });

  if (!filtered.length) {
    container.innerHTML = `
      <div style="
        padding:50px 20px;
        text-align:center;
        color:#666;
        font-size:12px;
      ">
        해당하는 과목이 없습니다.
      </div>
    `;

    return;
  }

  container.innerHTML =
    filtered.map(renderSubject).join("");
}


/* =========================================================
   RENDER ONE SUBJECT
========================================================= */

function renderSubject(subject) {

  const result =
    calculateSubject(subject);

  const style =
    categoryStyle[subject.category];

  const percent =
    result.total
      ? (result.entered / result.total) * 100
      : 0;

  let gradeHTML = `
    <div class="grade-summary">
      <div style="color:#666;font-size:11px;">
        미입력
      </div>
    </div>
  `;

  if (result.grade) {
    gradeHTML = `
      <div class="grade-summary">
        <div class="grade">
          ${result.grade}
          <span class="grade-point">
            ${result.point.toFixed(1)}
          </span>
        </div>

        <div class="score-summary">
          ${result.score.toFixed(1)}점
          ${result.complete ? "" : " · 예상"}
        </div>
      </div>
    `;
  }

  const assessments =
    subject.assessments.map(
      (assessment, index) => {

        const [
          name,
          kind,
          max,
          weight
        ] = assessment;

        const value =
          scores[subject.id]?.[index];

        const valueText =
          value === undefined
            ? ""
            : value;

        return `
          <div class="assessment">

            <div class="assessment-label">

              <div
                class="assessment-name"
                title="${escapeHTML(name)}"
              >
                ${escapeHTML(name)}
              </div>

              <span
                class="tag ${
                  kind === "exam"
                    ? "tag-exam"
                    : "tag-performance"
                }"
              >
                ${weight}%
              </span>

            </div>

            <div class="score-box">

              <input
                class="score-input"
                type="number"
                min="0"
                max="${max}"
                step="0.1"
                inputmode="decimal"
                placeholder="점수 입력"
                value="${valueText}"
                data-subject="${subject.id}"
                data-assessment="${index}"
                data-max="${max}"
              />

              <span class="max-score">
                / ${max}
              </span>

            </div>

            <div
              class="error"
              id="error-${subject.id}-${index}"
            ></div>

          </div>
        `;
      }
    ).join("");

  return `
    <article class="subject">

      <div class="subject-header">

        <div
          class="subject-icon"
          style="
            color:${style.color};
            background:${style.background};
          "
        >
          ${subject.icon}
        </div>

        <div class="subject-info">

          <div class="subject-name">
            ${subject.name}
          </div>

          <div class="subject-meta">
            ${subject.credits}학점
            <span style="color:#333">│</span>
            평가 ${subject.assessments.length}개
          </div>

        </div>

        <div class="progress-wrap">

          <div class="progress">
            <div
              class="progress-fill"
              style="width:${percent}%"
            ></div>
          </div>

          <div class="progress-text">
            ${result.entered}/${result.total}
          </div>

        </div>

        ${gradeHTML}

      </div>

      <div class="assessments">

        ${
          assessments
            ? `<div class="assessment-grid">
                ${assessments}
               </div>`
            : ""
        }

        <div class="subject-note">
          ${
            subject.assessments.length
              ? "빈칸은 미입력으로 처리됩니다. 0점도 성적에 반영됩니다."
              : "평가 항목이 등록되지 않은 과목입니다."
          }
        </div>

      </div>

    </article>
  `;
}


/* =========================================================
   INPUT EVENTS
========================================================= */

document.addEventListener(
  "input",
  function(event) {

    const input = event.target;

    if (
      !input.classList.contains("score-input")
    ) {
      return;
    }

    const subjectId =
      input.dataset.subject;

    const assessmentIndex =
      Number(input.dataset.assessment);

    const max =
      Number(input.dataset.max);

    let value = input.value;

    const error =
      document.getElementById(
        `error-${subjectId}-${assessmentIndex}`
      );

    if (value === "") {

      if (scores[subjectId]) {
        delete scores[subjectId][assessmentIndex];
      }

      if (error) {
        error.textContent = "";
      }

      saveData();
      updateDashboard();
      return;
    }

    const number =
      Number(value);

    if (
      !Number.isFinite(number) ||
      number < 0 ||
      number > max
    ) {

      if (error) {
        error.textContent =
          `0 ~ ${max}점 사이로 입력하세요.`;
      }

      return;
    }

    if (!scores[subjectId]) {
      scores[subjectId] = {};
    }

    scores[subjectId][assessmentIndex] =
      number;

    if (error) {
      error.textContent = "";
    }

    saveData();
    updateDashboard();
  }
);


/* =========================================================
   BLUR → RENDER
========================================================= */

document.addEventListener(
  "change",
  function(event) {

    const input = event.target;

    if (
      input.classList.contains("score-input")
    ) {
      renderSubjects();
      updateDashboard();
    }
  }
);


/* =========================================================
   DASHBOARD
========================================================= */

function updateDashboard() {

  let totalCredits = 0;
  let weightedPoints = 0;

  let entered = 0;
  let total = 0;

  let validSubjects = [];

  subjects.forEach(subject => {

    totalCredits += subject.credits;

    const result =
      calculateSubject(subject);

    entered += result.entered;
    total += result.total;

    if (
      result.point !== null
    ) {
      weightedPoints +=
        result.point * subject.credits;

      validSubjects.push(result);
    }
  });

  const totalSubjectCredits =
    validSubjects.length
      ? validSubjects.reduce(
          (sum, result, index) => {
            const subject =
              subjects.find(
                s =>
                  calculateSubject(s).point === result.point
              );

            return sum;
          },
          0
        )
      : 0;

  /*
    GPA는 실제 과목별 학점으로 계산
  */

  let gpaNumerator = 0;
  let gpaDenominator = 0;

  subjects.forEach(subject => {

    const result =
      calculateSubject(subject);

    if (result.point !== null) {

      gpaNumerator +=
        result.point * subject.credits;

      gpaDenominator +=
        subject.credits;
    }
  });

  const gpa =
    gpaDenominator
      ? gpaNumerator / gpaDenominator
      : 0;

  document.getElementById("gpaValue")
    .textContent = gpa.toFixed(2);

  document.getElementById("enteredValue")
    .textContent =
      `${entered} / ${total}`;

  document.getElementById("creditValue")
    .textContent =
      gpaDenominator;

  const currentGrade =
    getOverallGrade(gpa);

  document.getElementById("gradeValue")
    .textContent =
      currentGrade || "—";

  const description =
    document.getElementById("gpaDescription");

  if (!entered) {

    description.textContent =
      "아직 입력된 점수가 없습니다.";

  } else if (!gpaDenominator) {

    description.textContent =
      "점수를 입력하면 예상 GPA가 계산됩니다.";

  } else {

    const difference =
      gpa - targetGpa;

    if (difference >= 0) {
      description.textContent =
        `목표 GPA보다 ${difference.toFixed(2)} 높습니다.`;
    } else {
      description.textContent =
        `목표 GPA까지 ${(Math.abs(difference)).toFixed(2)}가 필요합니다.`;
    }
  }

  const percent =
    Math.min(
      100,
      Math.max(
        0,
        (gpa / 4.3) * 100
      )
    );

  document
    .getElementById("gpaRing")
    .style.setProperty(
      "--progress",
      `${percent}%`
    );

  document.getElementById("gpaPercent")
    .textContent =
      `${Math.round(percent)}%`;
}


/* =========================================================
   OVERALL GRADE
========================================================= */

function getOverallGrade(gpa) {

  if (gpa === 0) {
    return null;
  }

  const bands = [
    [4.3, "A+"],
    [4.0, "A0"],
    [3.7, "A−"],
    [3.3, "B+"],
    [3.0, "B0"],
    [2.7, "B−"],
    [2.3, "C+"],
    [2.0, "C0"],
    [1.7, "C−"],
    [1.3, "D+"],
    [1.0, "D0"],
    [0.7, "D−"]
  ];

  for (const [point, grade] of bands) {
    if (gpa >= point) {
      return grade;
    }
  }

  return "F";
}


/* =========================================================
   TARGET GPA
========================================================= */

document
  .getElementById("targetInput")
  .addEventListener(
    "input",
    function() {

      let value =
        Number(this.value);

      if (!Number.isFinite(value)) {
        value = 4.0;
      }

      value =
        Math.max(
          0,
          Math.min(4.3, value)
        );

      targetGpa = value;

      document.getElementById(
        "targetValue"
      ).textContent =
        value.toFixed(2);

      saveData();
      updateDashboard();
    }
  );


/* =========================================================
   SEARCH / FILTER
========================================================= */

document
  .getElementById("searchInput")
  .addEventListener(
    "input",
    renderSubjects
  );

document
  .getElementById("categoryFilter")
  .addEventListener(
    "change",
    renderSubjects
  );


/* =========================================================
   RESET
========================================================= */

function resetScores() {

  const confirmed =
    confirm(
      "모든 과목의 점수를 삭제할까요?"
    );

  if (!confirmed) {
    return;
  }

  scores = {};

  saveData();
  renderSubjects();
  updateDashboard();
}


/* =========================================================
   EXPORT
========================================================= */

function exportData() {

  const data = {
    app: "시크릿 모드",
    version: 1,
    scores,
    targetGpa,
    exportedAt:
      new Date().toISOString()
  };

  const blob =
    new Blob(
      [
        JSON.stringify(
          data,
          null,
          2
        )
      ],
      {
        type: "application/json"
      }
    );

  const url =
    URL.createObjectURL(blob);

  const a =
    document.createElement("a");

  a.href = url;
  a.download =
    "secret-mode-grades.json";

  a.click();

  URL.revokeObjectURL(url);
}


/* =========================================================
   IMPORT
========================================================= */

function importData(event) {

  const file =
    event.target.files[0];

  if (!file) {
    return;
  }

  const reader =
    new FileReader();

  reader.onload = function(e) {

    try {

      const data =
        JSON.parse(e.target.result);

      if (
        !data ||
        typeof data !== "object"
      ) {
        throw new Error();
      }

      scores =
        data.scores || {};

      targetGpa =
        typeof data.targetGpa === "number"
          ? data.targetGpa
          : 4.0;

      document.getElementById(
        "targetInput"
      ).value =
        targetGpa.toFixed(2);

      saveData();
      renderSubjects();
      updateDashboard();

      alert(
        "데이터를 불러왔습니다."
      );

    } catch (error) {

      alert(
        "올바른 데이터 파일이 아닙니다."
      );
    }

    event.target.value = "";
  };

  reader.readAsText(file);
}


/* =========================================================
   GRADE TABLE
========================================================= */

function showGradeTable() {

  const text =
    gradeBands
      .map(
        band =>
          `${band.label} : ${band.min}점 이상 · ${band.point.toFixed(1)}점`
      )
      .join("\n");

  alert(
    "평가 등급표\n\n" + text
  );
}


/* =========================================================
   SCROLL
========================================================= */

function scrollToSubjects() {

  document
    .getElementById("subjectSection")
    .scrollIntoView({
      behavior: "smooth"
    });
}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}


/* =========================================================
   START
========================================================= */

loadData();
renderSubjects();
updateDashboard();

</script>

