/* =========================================================
   GRADE SYSTEM
========================================================= */

const gradeBands = [
  { label: "A+", min: 97, point: 4.3 },
  { label: "A0", min: 93, point: 4.0 },
  { label: "A−", min: 90, point: 3.7 },
  { label: "B+", min: 87, point: 3.3 },
  { label: "B0", min: 83, point: 3.0 },
  { label: "B−", min: 80, point: 2.7 },
  { label: "C+", min: 77, point: 2.3 },
  { label: "C0", min: 73, point: 2.0 },
  { label: "C−", min: 70, point: 1.7 },
  { label: "D+", min: 67, point: 1.3 },
  { label: "D0", min: 63, point: 1.0 },
  { label: "D−", min: 60, point: 0.7 },
  { label: "F", min: 0, point: 0 }
];

const STORAGE_KEY = "secret-mode-grades-v1";

let scores = {};
let targetGpa = 4.0;


/* =========================================================
   LOAD
========================================================= */

function loadData() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (saved) {
      const data = JSON.parse(saved);

      scores = data.scores || {};
      targetGpa =
        typeof data.targetGpa === "number"
          ? data.targetGpa
          : 4.0;
    }
  } catch (e) {
    scores = {};
    targetGpa = 4.0;
  }

  document.getElementById("targetInput").value =
    targetGpa.toFixed(2);
}


/* =========================================================
   SAVE
========================================================= */

function saveData() {
  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify({
      scores,
      targetGpa,
      updatedAt: new Date().toISOString()
    })
  );

  const status = document.getElementById("saveStatus");

  status.textContent = "저장됨";

  setTimeout(() => {
    status.textContent = "자동 저장됨";
  }, 1000);
}


/* =========================================================
   CALCULATE SUBJECT
========================================================= */

function calculateSubject(subject) {
  if (!subject.assessments.length) {
    return {
      score: null,
      grade: null,
      point: null,
      entered: 0,
      total: 0,
      complete: false
    };
  }

  let weightedScore = 0;
  let entered = 0;

  subject.assessments.forEach((a, index) => {
    const value =
      scores[subject.id]?.[index];

    if (
      value !== undefined &&
      value !== null &&
      value !== ""
    ) {
      entered++;

      weightedScore +=
        (Number(value) / a[2]) * a[3];
    }
  });

  const score =
    entered > 0
      ? weightedScore
      : null;

  let grade = null;
  let point = null;

  if (score !== null) {
    const band = gradeBands.find(
      b => score >= b.min
    );

    if (band) {
      grade = band.label;
      point = band.point;
    }
  }

  return {
    score,
    grade,
    point,
    entered,
    total: subject.assessments.length,
    complete:
      entered === subject.assessments.length
  };
}


