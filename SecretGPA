<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0"
  />
  <meta name="theme-color" content="#090909" />
  <title>시크릿 모드</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --bg: #090909;
      --surface: #111111;
      --surface-2: #171717;
      --surface-3: #1d1d1d;
      --border: #292929;
      --border-light: #353535;

      --text: #f5f5f5;
      --text-2: #c7c7c7;
      --muted: #858585;
      --muted-2: #5f5f5f;

      --accent: #a78bfa;
      --accent-dark: #8b6fe8;
      --accent-bg: #29233d;

      --green: #70b6a2;
      --green-bg: #1d302b;

      --red: #e57373;

      --radius: 12px;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      background: var(--bg);
      color: var(--text);
      font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Pretendard",
        "Noto Sans KR",
        "Segoe UI",
        sans-serif;
    }

    body {
      min-height: 100vh;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .app {
      min-height: 100vh;
      display: flex;
      background: var(--bg);
    }

    /* =========================
       SIDEBAR
    ========================= */

    .sidebar {
      width: 240px;
      min-height: 100vh;
      border-right: 1px solid var(--border);
      background: #0d0d0d;
      padding: 26px 16px;
      position: fixed;
      left: 0;
      top: 0;
      bottom: 0;
      z-index: 20;
    }

    .logo {
      padding: 10px 12px 28px;
    }

    .logo-title {
      font-size: 21px;
      font-weight: 800;
      letter-spacing: -0.8px;
    }

    .logo-title span {
      color: var(--accent);
    }

    .logo-sub {
      margin-top: 5px;
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .nav-title {
      color: #555;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1.2px;
      margin: 20px 12px 8px;
    }

    .nav-btn {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 11px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: #888;
      padding: 11px 12px;
      margin-bottom: 3px;
      text-align: left;
    }

    .nav-btn:hover {
      background: #171717;
      color: #ddd;
    }

    .nav-btn.active {
      background: var(--accent-bg);
      color: var(--accent);
    }

    .nav-icon {
      width: 18px;
      text-align: center;
      font-size: 15px;
    }

    .privacy-box {
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 24px;
      padding: 14px;
      background: #141414;
      border: 1px solid var(--border);
      border-radius: 9px;
    }

    .privacy-title {
      font-size: 11px;
      font-weight: 700;
      color: #ddd;
      margin-bottom: 5px;
    }

    .privacy-text {
      font-size: 10px;
      line-height: 1.6;
      color: #666;
    }

    /* =========================
       MAIN
    ========================= */

    .main {
      width: calc(100% - 240px);
      margin-left: 240px;
      min-height: 100vh;
    }

    .topbar {
      height: 70px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 38px;
      position: sticky;
      top: 0;
      background: rgba(9, 9, 9, 0.92);
      backdrop-filter: blur(16px);
      z-index: 10;
    }

    .page-title {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.4px;
    }

    .top-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .save-status {
      color: var(--muted);
      font-size: 11px;
    }

    .content {
      max-width: 1180px;
      margin: 0 auto;
      padding: 42px 38px 80px;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 30px;
      margin-bottom: 28px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 2px;
      margin-bottom: 10px;
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(28px, 4vw, 42px);
      letter-spacing: -1.8px;
      line-height: 1.1;
    }

    .hero p {
      color: var(--muted);
      font-size: 13px;
      margin: 11px 0 0;
    }

    .semester {
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 10px;
      padding: 15px 18px;
      min-width: 180px;
    }

    .semester-label {
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 6px;
    }

    .semester-value {
      font-size: 13px;
      font-weight: 700;
    }

    /* =========================
       GPA
    ========================= */

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 14px;
      margin-bottom: 14px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .gpa-card {
      padding: 28px;
      min-height: 190px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .small-label {
      color: var(--muted);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 1px;
    }

    .gpa-number {
      margin-top: 8px;
      font-size: 58px;
      line-height: 1;
      font-weight: 800;
      letter-spacing: -3px;
    }

    .gpa-max {
      font-size: 13px;
      color: var(--muted);
      margin-left: 5px;
      letter-spacing: 0;
    }

    .gpa-description {
      color: var(--muted);
      font-size: 11px;
      margin-top: 13px;
    }

    .gpa-ring {
      width: 112px;
      height: 112px;
      border-radius: 50%;
      background:
        radial-gradient(circle at center, #111 57%, transparent 58%),
        conic-gradient(
          var(--accent) var(--progress),
          #282828 var(--progress)
        );
      display: flex;
      align-items: center;
      justify-content: center;
      margin-right: 15px;
    }

    .ring-inner {
      font-size: 12px;
      font-weight: 700;
      color: #ccc;
    }

    .target-card {
      padding: 25px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .target-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .target-value {
      font-size: 32px;
      font-weight: 800;
      color: var(--accent);
      margin-top: 12px;
    }

    .target-input {
      width: 100%;
      margin-top: 15px;
      height: 42px;
      border-radius: 7px;
      border: 1px solid var(--border-light);
      background: #0c0c0c;
      color: var(--text);
      padding: 0 12px;
      outline: none;
    }

    .target-input:focus {
      border-color: var(--accent);
    }

    /* =========================
       METRICS
    ========================= */

    .metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-bottom: 38px;
    }

    .metric {
      padding: 19px 20px;
    }

    .metric-name {
      color: var(--muted);
      font-size: 10px;
      margin-bottom: 7px;
    }

    .metric-value {
      font-size: 22px;
      font-weight: 750;
    }

    /* =========================
       SUBJECT HEADER
    ========================= */

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 20px;
      margin-bottom: 17px;
    }

    .section-title {
      font-size: 20px;
      font-weight: 800;
      letter-spacing: -0.6px;
    }

    .section-subtitle {
      color: var(--muted);
      font-size: 11px;
      margin-top: 6px;
    }

    .tools {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .search {
      width: 190px;
      height: 38px;
      background: var(--surface);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 7px;
      padding: 0 12px;
      outline: none;
      font-size: 12px;
    }

    .search:focus {
      border-color: var(--accent);
    }

    .filter {
      height: 38px;
      padding: 0 12px;
      border-radius: 7px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: #999;
      font-size: 11px;
    }

    .filter.active {
      color: var(--accent);
      border-color: #40375e;
      background: var(--accent-bg);
    }

    /* =========================
       SUBJECT
    ========================= */

    #subjects {
      overflow: hidden;
    }

    .subject {
      border-bottom: 1px solid var(--border);
      background: #111;
    }

    .subject:last-child {
      border-bottom: 0;
    }

    .subject-header {
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .subject-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 17px;
      flex-shrink: 0;
    }

    .subject-info {
      flex: 1;
      min-width: 0;
    }

    .subject-name {
      font-size: 14px;
      font-weight: 700;
    }

    .subject-meta {
      color: #666;
      font-size: 10px;
      margin-top: 5px;
    }

    .progress-wrap {
      width: 170px;
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .progress {
      height: 4px;
      flex: 1;
      background: #292929;
      border-radius: 5px;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      background: var(--accent);
      border-radius: 5px;
      transition: width 0.25s ease;
    }

    .progress-text {
      color: #666;
      font-size: 10px;
      width: 32px;
    }

    .grade-summary {
      width: 95px;
      text-align: right;
    }

    .grade {
      color: var(--accent);
      font-size: 17px;
      font-weight: 800;
    }

    .grade-point {
      color: #777;
      font-size: 10px;
      margin-left: 3px;
    }

    .score-summary {
      color: #666;
      font-size: 10px;
      margin-top: 4px;
    }

    /* =========================
       ASSESSMENTS
    ========================= */

    .assessments {
      background: #181818;
      padding: 20px 22px 23px;
      border-top: 1px solid #202020;
    }

    .assessment-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 13px;
    }

    .assessment {
      min-width: 0;
    }

    .assessment-label {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 7px;
      margin-bottom: 8px;
    }

    .assessment-name {
      color: #b8b8b8;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .tag {
      font-size: 9px;
      font-weight: 700;
      padding: 4px 7px;
      border-radius: 4px;
      flex-shrink: 0;
    }

    .tag-exam {
      color: #b9a7ff;
      background: #29233d;
    }

    .tag-performance {
      color: #70b6a2;
      background: #1d302b;
    }

    .score-box {
      height: 46px;
      display: flex;
      align-items: center;
      background: #101010;
      border: 1px solid #353535;
      border-radius: 7px;
      padding: 0 11px;
      transition: border-color 0.15s;
    }

    .score-box:focus-within {
      border-color: var(--accent);
    }

    .score-input {
      width: 100%;
      min-width: 0;
      height: 100%;
      background: transparent;
      border: 0;
      outline: 0;
      color: #f5f5f5;
      font-size: 14px;
      padding: 0;
    }

    .score-input::placeholder {
      color: #555;
    }

    .max-score {
      color: #555;
      font-size: 10px;
      white-space: nowrap;
      margin-left: 8px;
    }

    .error {
      color: var(--red);
      font-size: 9px;
      margin-top: 5px;
    }

    .subject-note {
      color: #666;
      font-size: 10px;
      margin-top: 16px;
      line-height: 1.6;
    }

    /* =========================
       BOTTOM
    ========================= */

    .bottom-tools {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 22px;
      gap: 12px;
    }

    .action-buttons {
      display: flex;
      gap: 7px;
    }

    .btn {
      height: 38px;
      border-radius: 7px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: #aaa;
      padding: 0 13px;
      font-size: 11px;
    }

    .btn:hover {
      border-color: #444;
      color: #ddd;
    }

    .btn.primary {
      border-color: transparent;
      background: var(--accent);
      color: #0b0b0b;
      font-weight: 700;
    }

    .btn.danger {
      color: #d77;
    }

    .footer {
      text-align: center;
      color: #454545;
      font-size: 10px;
      margin-top: 50px;
      padding-bottom: 20px;
    }

    /* =========================
       MOBILE
    ========================= */

    .mobile-top {
      display: none;
    }

    @media (max-width: 900px) {
      .sidebar {
        display: none;
      }

      .main {
        width: 100%;
        margin-left: 0;
      }

      .topbar {
        padding: 0 18px;
      }

      .mobile-top {
        display: flex;
        align-items: center;
        gap: 9px;
      }

      .mobile-logo {
        font-size: 16px;
        font-weight: 800;
      }

      .content {
        padding: 28px 16px 80px;
      }

      .dashboard-grid {
        grid-template-columns: 1fr;
      }

      .metrics {
        grid-template-columns: repeat(3, 1fr);
      }

      .hero {
        align-items: flex-start;
        flex-direction: column;
      }

      .semester {
        width: 100%;
      }

      .progress-wrap {
        display: none;
      }
    }

    @media (max-width: 600px) {
      .topbar {
        height: 60px;
      }

      .page-title {
        display: none;
      }

      .content {
        padding: 25px 12px 70px;
      }

      .hero h1 {
        font-size: 29px;
      }

      .hero p {
        font-size: 12px;
      }

      .gpa-card {
        padding: 22px;
      }

      .gpa-number {
        font-size: 48px;
      }

      .gpa-ring {
        width: 88px;
        height: 88px;
        margin-right: 0;
      }

      .metrics {
        gap: 7px;
      }

      .metric {
        padding: 15px 12px;
      }

      .metric-value {
        font-size: 17px;
      }

      .section-header {
        flex-direction: column;
        align-items: stretch;
      }

      .tools {
        width: 100%;
      }

      .search {
        flex: 1;
        width: auto;
      }

      .filter {
        flex-shrink: 0;
      }

      .subject-header {
        padding: 16px;
        gap: 10px;
      }

      .subject-icon {
        width: 36px;
        height: 36px;
      }

      .grade-summary {
        width: 65px;
      }

      .assessments {
        padding: 16px;
      }

      .assessment-grid {
        grid-template-columns: 1fr 1fr;
        gap: 11px;
      }

      .assessment-name {
        font-size: 10px;
      }

      .bottom-tools {
        flex-direction: column;
        align-items: stretch;
      }

      .action-buttons {
        width: 100%;
      }

      .btn {
        flex: 1;
      }
    }

    @media (max-width: 390px) {
      .assessment-grid {
        grid-template-columns: 1fr;
      }

      .grade-summary {
        width: 55px;
      }
    }
  </style>
</head>

<body>
<div class="app">

  <!-- =========================
       SIDEBAR
  ========================== -->

  <aside class="sidebar">
    <div class="logo">
      <div class="logo-title">
        시크릿 모드<span>.</span>
      </div>
      <div class="logo-sub">
        private grade calculator
      </div>
    </div>

    <div class="nav-title">MENU</div>

    <button class="nav-btn active">
      <span class="nav-icon">◈</span>
      학점 계산기
    </button>

    <button class="nav-btn" onclick="scrollToSubjects()">
      <span class="nav-icon">▦</span>
      나의 과목
    </button>

    <button class="nav-btn" onclick="showGradeTable()">
      <span class="nav-icon">◇</span>
      평가 배점표
    </button>

    <div class="privacy-box">
      <div class="privacy-title">🔒 PRIVATE MODE</div>
      <div class="privacy-text">
        입력한 점수는 이 브라우저의
        로컬 저장소에만 저장됩니다.
      </div>
    </div>
  </aside>

  <!-- =========================
       MAIN
  ========================== -->

  <main class="main">

    <header class="topbar">
      <div class="mobile-top">
        <div class="mobile-logo">
          시크릿 모드<span style="color:#a78bfa">.</span>
        </div>
      </div>

      <div class="page-title">
        학점 계산기
      </div>

      <div class="top-right">
        <span class="save-status" id="saveStatus">
          자동 저장됨
        </span>
      </div>
    </header>

    <div class="content">

      <!-- HERO -->

      <section class="hero">
        <div>
          <div class="eyebrow">
            SECRET MODE
          </div>

          <h1>
            나의 학점, 한눈에.
          </h1>

          <p>
            평가 항목별 점수를 입력하면 예상 학점이 자동으로 계산됩니다.
          </p>
        </div>

        <div class="semester">
          <div class="semester-label">
            현재 학기
          </div>

          <div class="semester-value">
            1학년 · 2학기
          </div>
        </div>
      </section>

      <!-- GPA -->

      <section class="dashboard-grid">

        <div class="card gpa-card">

          <div>
            <div class="small-label">
              CURRENT GPA
            </div>

            <div>
              <span class="gpa-number" id="gpaValue">
                0.00
              </span>
              <span class="gpa-max">
                / 4.3
              </span>
            </div>

            <div class="gpa-description" id="gpaDescription">
              아직 입력된 점수가 없습니다.
            </div>
          </div>

          <div class="gpa-ring" id="gpaRing">
            <div class="ring-inner">
              <span id="gpaPercent">0%</span>
            </div>
          </div>

        </div>

        <div class="card target-card">

          <div class="target-top">
            <div class="small-label">
              TARGET GPA
            </div>
          </div>

          <div class="target-value" id="targetValue">
            4.00
          </div>

          <input
            id="targetInput"
            class="target-input"
            type="number"
            min="0"
            max="4.3"
            step="0.01"
            value="4.00"
            inputmode="decimal"
            placeholder="목표 GPA"
          />

        </div>

      </section>

      <!-- METRICS -->

      <section class="metrics">

        <div class="card metric">
          <div class="metric-name">
            입력 완료
          </div>

          <div class="metric-value" id="enteredValue">
            0 / 0
          </div>
        </div>

        <div class="card metric">
          <div class="metric-name">
            총 학점
          </div>

          <div class="metric-value" id="creditValue">
            0
          </div>
        </div>

        <div class="card metric">
          <div class="metric-name">
            예상 등급
          </div>

          <div class="metric-value" id="gradeValue">
            —
          </div>
        </div>

      </section>

      <!-- SUBJECTS -->

      <section id="subjectSection">

        <div class="section-header">

          <div>
            <div class="section-title">
              나의 과목
            </div>

            <div class="section-subtitle">
              평가 항목별 점수를 입력하면 자동으로 반영됩니다.
            </div>
          </div>

          <div class="tools">

            <input
              id="searchInput"
              class="search"
              type="search"
              placeholder="과목 검색..."
            />

            <select id="categoryFilter" class="filter">
              <option value="전체">전체</option>
              <option value="인문">인문</option>
              <option value="수학">수학</option>
              <option value="과학">과학</option>
              <option value="예체능">예체능</option>
            </select>

          </div>

        </div>

        <div class="card" id="subjects"></div>

        <div class="bottom-tools">

          <div class="action-buttons">

            <button class="btn" onclick="exportData()">
              데이터 내보내기
            </button>

            <button class="btn" onclick="document.getElementById('fileInput').click()">
              데이터 불러오기
            </button>

            <input
              id="fileInput"
              type="file"
              accept=".json"
